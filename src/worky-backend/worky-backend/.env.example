# Copiá este archivo como ".env" (sin el ".example") y completá con tus datos reales.
# El archivo ".env" NUNCA se sube a git ni se comparte — ya está listado en .gitignore.

# Pegá acá el connection string que te dio Atlas, agregando "/worky" antes del "?"
# Ejemplo: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/worky?retryWrites=true&w=majority
MONGODB_URI=

# Puerto donde corre el servidor local
PORT=4000

# Cualquier texto largo y random, usado para firmar los tokens de sesión (JWT)
JWT_SECRET=

# Cuántas horas dura una sesión antes de pedir login de nuevo
JWT_EXPIRES_IN=7d
